# Copy to .env locally; never commit a real key.
AGENT_PROVIDER=rules
# To use DeepSeek: AGENT_PROVIDER=deepseek, DEEPSEEK_API_KEY and AGENT_MODEL=deepseek-flash.
# To use OpenAI: AGENT_PROVIDER=openai, OPENAI_API_KEY and an available AGENT_MODEL.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
AGENT_MODEL=
# Optional output cap; does not change the data/tool limits.
AGENT_MAX_OUTPUT_TOKENS=1400
