{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recommendation_update provider-facing illustrative schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.0.0"
      ]
    },
    "record_type": {
      "type": "string",
      "enum": [
        "recommendation_update"
      ]
    },
    "update_id": {
      "type": "string"
    },
    "context_id": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "student"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "audience": {
      "type": "string",
      "enum": [
        "teacher",
        "student"
      ]
    },
    "graph_ref": {
      "type": "object",
      "properties": {
        "graph_id": {
          "type": "string"
        },
        "graph_version": {
          "type": "integer"
        }
      },
      "required": [
        "graph_id",
        "graph_version"
      ],
      "additionalProperties": false
    },
    "basis_snapshot": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "profile_version": {
      "type": "integer"
    },
    "base_bundle_id": {
      "type": "string"
    },
    "base_bundle_version": {
      "type": "integer"
    },
    "proposed_bundle_version": {
      "type": "integer"
    },
    "resource_catalog_version": {
      "type": "integer"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "candidate"
      ]
    },
    "generated_by": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "example",
            "llm"
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "model"
      ],
      "additionalProperties": false
    },
    "operations": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "upsert"
                ]
              },
              "recommendation_id": {
                "type": "string"
              },
              "recommendation": {
                "type": "object",
                "properties": {
                  "recommendation_id": {
                    "type": "string"
                  },
                  "audience": {
                    "type": "string",
                    "enum": [
                      "teacher",
                      "student"
                    ]
                  },
                  "target_node_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "overview",
                      "strength",
                      "low_score",
                      "provisional_low",
                      "needs_practice",
                      "missing_evidence",
                      "not_started"
                    ]
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "high",
                      "medium",
                      "low",
                      "info"
                    ]
                  },
                  "summary": {
                    "type": "string"
                  },
                  "basis_node_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "review_node_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "prepare_node_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "resource_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "origin": {
                    "type": "string",
                    "enum": [
                      "preset_demo",
                      "llm_candidate",
                      "llm_generated",
                      "teacher_authored"
                    ]
                  },
                  "lifecycle": {
                    "type": "string",
                    "enum": [
                      "active",
                      "candidate",
                      "archived"
                    ]
                  }
                },
                "required": [
                  "recommendation_id",
                  "audience",
                  "target_node_id",
                  "kind",
                  "priority",
                  "summary",
                  "basis_node_ids",
                  "evidence_refs",
                  "actions",
                  "review_node_ids",
                  "prepare_node_ids",
                  "resource_ids",
                  "origin",
                  "lifecycle"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "op",
              "recommendation_id",
              "recommendation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "remove"
                ]
              },
              "recommendation_id": {
                "type": "string"
              }
            },
            "required": [
              "op",
              "recommendation_id"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "update_id",
    "context_id",
    "subject",
    "audience",
    "graph_ref",
    "basis_snapshot",
    "profile_version",
    "base_bundle_id",
    "base_bundle_version",
    "proposed_bundle_version",
    "resource_catalog_version",
    "lifecycle",
    "generated_by",
    "operations"
  ],
  "additionalProperties": false
}
