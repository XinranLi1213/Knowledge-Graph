{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "record_type": {
      "const": "conversation_turn"
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "student",
                "class"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "subject",
        "scenario_id"
      ],
      "additionalProperties": false
    },
    "audience": {
      "enum": [
        "teacher",
        "student"
      ]
    },
    "target_node_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot_ref": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "snapshot_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "discussed_artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed"
      ]
    },
    "answer": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "explanation": {
              "type": "string",
              "minLength": 1
            },
            "cited_node_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "cited_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "resource_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sections": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "conclusion": {
                      "type": "string",
                      "minLength": 1
                    },
                    "actions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "verification": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "conclusion",
                    "actions",
                    "verification"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "explanation",
            "cited_node_ids",
            "cited_evidence_ids",
            "resource_ids",
            "limitations"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "enum": [
        "rules_demo",
        "model"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "turn_id",
    "session_id",
    "scope",
    "audience",
    "target_node_id",
    "snapshot_ref",
    "discussed_artifact_id",
    "question",
    "state",
    "answer",
    "origin",
    "created_at"
  ],
  "additionalProperties": false
}
